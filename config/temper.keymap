 * SPDX-License-Identifier: MIT
 *
 * Setzt macOS-deutsches QWERTZ-Layout im Betriebssystem voraus.
 * Fenster-Shortcuts: Raycast Window Management (Standardbelegung).
 *
 * LAYER-ÜBERSICHT
 * ───────────────
 * 0 QWTZ  Buchstaben (QWERTZ) + Home-Row-Mods
 * 1 SYM   Sonderzeichen + Zahlen  (tap=TAB / hold=SYM)
 * 2 NAV   Navigation + F-Tasten   (tap=Enter / hold=NAV)
 * 3 WM    Fensterverwaltung + Maus (tap=ESC / hold=WM)
 * 4 CFG   Tastatur-Konfiguration   (tap=Bspc / hold=CFG)
 *
 * HOME-ROW-MODS (halten = Modifier)
 * ───────────────────────────────────
 *   A=Shift  S=Ctrl  D=Alt  F=Cmd  |  J=Cmd  K=Alt  L=Ctrl  Ö=Shift
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define QWTZ 0
#define SYM  1
#define NAV  2
#define WM   3
#define CFG  4

#define ______ &trans

// ── Deutsches QWERTZ OS – Sonderzeichen-Aliase ──────────────────────────────
// AltGr-Kombinationen
#define DE_LCBR  RA(N8)     // {
#define DE_RCBR  RA(N9)     // }
#define DE_LBRC  RA(N5)     // [
#define DE_RBRC  RA(N6)     // ]
#define DE_BSLH  RA(MINUS)  // backslash  (AltGr+ß)
#define DE_AT    RA(L)      // @
#define DE_PIPE  RA(N7)     // |
#define DE_TILD  RA(RBKT)   // ~          (AltGr++)
// Shift-Kombinationen
#define DE_EXCL  LS(N1)     // !
#define DE_DQUO  LS(N2)     // "
#define DE_DLLR  LS(N4)     // $
#define DE_PERC  LS(N5)     // %
#define DE_AMPR  LS(N6)     // &
#define DE_SLSH  LS(N7)     // /
#define DE_LPAR  LS(N8)     // (
#define DE_RPAR  LS(N9)     // )
#define DE_EQL   LS(N0)     // =
#define DE_QUES  LS(MINUS)  // ?  (Shift+ß)
#define DE_QUOT  LS(NUHS)   // '
#define DE_STAR  LS(RBKT)   // *
// Sonstige
#define DE_PLUS  RBKT       // +
#define DE_HASH  NUHS       // #
#define DE_LT    GRAVE      // <
#define DE_GT    LS(GRAVE)  // >
#define DE_MINS  FSLH       // -  (HID FSLH = deutsches Minus)
#define DE_UNDS  LS(FSLH)   // _

/ {
    behaviors {
        mins_unds: mins_unds {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_MINS>, <&kp DE_UNDS>;
            mods = <(MOD_LSFT)>;
        };
        // Home-Row-Mod: hold=Modifier, tap=Buchstabe
        // tapping-term 280ms + require-prior-idle reduzieren Fehltrigger beim schnellen Tippen
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ── Layer 0: QWERTZ ────────────────────────────────────────────────
        // Home-Row: A=⇧ · S=⌃ · D=⌥ · F=⌘  |  J=⌘ · K=⌥ · L=⌃ · Ö=⇧
        // Daumen:  [ESC/WM] [TAB/SYM] [Space]  |  [RET] [Bspc/NAV] [Del/CFG]
        qwertz_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp Q         &kp W         &kp E         &kp R         &kp T             &kp Y         &kp U         &kp I         &kp O         &kp P
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
     &hm LSHFT A   &hm LCTRL S   &hm LALT D    &hm LGUI F      &kp G             &kp H       &hm RGUI J    &hm RALT K    &hm RCTRL L  &hm RSHFT SEMI
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp Z         &kp X         &kp C         &kp V         &kp B             &kp N         &kp M       &kp DE_QUES    &kp DE_EXCL   &mins_unds
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                  &tlt WM ESC   &tlt SYM TAB  &kp SPACE          &kp RET      &tlt NAV BSPC &tlt CFG DEL
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // ── Layer 1: SYM – Sonderzeichen + Zahlen ──────────────────────────
        // Brackets auf Home-Row: ( ) – eine Reihe drüber: { } – darunter: [ ]
        // Daumen: < · [held] · >  |  ' · 0 · _
        sym_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp DE_EXCL  &kp DE_DQUO  &kp DE_LCBR  &kp DE_RCBR  &kp DE_PIPE        &kp DE_AMPR   &kp N7        &kp N8        &kp N9      &kp DE_STAR
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp DE_HASH  &kp DE_AT    &kp DE_LPAR  &kp DE_RPAR  &kp DE_EQL         &kp DE_PERC   &kp N4        &kp N5        &kp N6      &kp DE_PLUS
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp DE_TILD  &kp DE_DLLR  &kp DE_LBRC  &kp DE_RBRC  &kp DE_BSLH        &kp DE_QUES   &kp N1        &kp N2        &kp N3      &kp DE_SLSH
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                  &kp DE_LT     ______       &kp DE_GT          &kp DE_QUOT   &kp N0       &kp DE_UNDS
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // ── Layer 2: NAV – Navigation + F-Tasten ───────────────────────────
        // Links: F1-F12  |  Rechts: Pfeiltasten (Inverted-T), PgUp/Dn, Word-Nav
        // Daumen: Tab · Cmd · [⇧]  |  [Space] · [held] · [Bspc]
        nav_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5           &kp PG_UP    &kp HOME      &kp UP        &kp END      &kp PG_DN
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10          &kp DEL      &kp LEFT      &kp DOWN      &kp RIGHT    &kp BSPC
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp F11       &kp F12       &kp PSCRN     &kp CAPS      &kp ESC          &kp INS    &kp LA(LEFT)    ______      &kp LA(RIGHT) &kp LA(BSPC)
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    &kp TAB       &kp LGUI      ______            ______        ______        ______
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // ── Layer 3: WM – Fensterverwaltung (Raycast) + Maus ───────────────
        // R1: MissionCtrl · AppExposé · ⌘Space · ⌘Tab · ⌃⌥↓
        // R2: ObenLinks · LinksHälfte · Maximieren · RechtsHälfte · ObenRechts
        // R3: sk⌘ · sk⌥ · sk⌃ · sk⇧ · ⌃⌥C(Zentrieren)
        // Daumen: [held] · ⌥ · ⇧  |  MB1 · MB2 · MB3
        wm_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp LC(UP)  &kp LC(DOWN)  &kp LG(SPACE)  &kp LG(TAB)  &kp LC(LA(DOWN))  &mkp MB4      &mkp MB5   &mmv MOVE_UP  &kp LC(LA(BSPC)) &msc SCRL_UP
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
   &kp LC(LA(U)) &kp LC(LA(LEFT)) &kp LC(LA(RET)) &kp LC(LA(RIGHT)) &kp LC(LA(I))  ______  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &sk LGUI      &sk LALT      &sk LCTRL     &sk LSHFT   &kp LC(LA(C))     &msc SCRL_LEFT  &kp ESC      &kp RET       &kp DEL     &msc SCRL_RIGHT
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    ______        &kp LALT     &kp LSHFT         &mkp MB1      &mkp MB2      &mkp MB3
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // ── Layer 4: CFG – Tastatur-Konfiguration ──────────────────────────
        // Daumen: ⌘ · ⌥ · ⇧  |  Space · Enter · [held]
        cfg_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp PSCRN    &kp C_BRI_DN  &kp C_BRI_UP  &out OUT_USB  &out OUT_BLE
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &bt BT_CLR   &out OUT_TOG  &kp LC(LG(Q))  &kp C_SLEEP   &kp CAPS        &kp C_SLEEP  &kp C_VOL_DN  &kp C_VOL_UP  &kp K_MUTE    &kp K_APP
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &sys_reset    &bootloader  &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5))  &kp C_STOP   &kp C_PREV    &kp C_PP     &kp C_NEXT    &kp C_EJECT
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &kp LGUI      &kp LALT     &kp LSHFT         &kp SPACE     &kp RET        ______
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };
    };
};
