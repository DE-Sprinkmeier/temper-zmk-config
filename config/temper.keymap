 *
 * Setzt deutsches QWERTZ-Layout im Betriebssystem voraus.
 * Fenster-Shortcuts: Raycast Window Management (Standardbelegung).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define QWTZ 0
#define FN   1
#define WM   2
#define CFG  3

#define ______ &trans

/ {
    behaviors {
        smart_shft: smart_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // QWERTZ – Setzt deutsches QWERTZ im OS voraus.
        // kp Y → HID Y-Code → deutsches OS → 'z'
        // kp Z → HID Z-Code → deutsches OS → 'y'
        // kp SEMI → HID Semikolon → deutsches OS → 'ö'
        qwertz_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp Q         &kp W         &kp E         &kp R         &kp T             &kp Y         &kp U         &kp I         &kp O         &kp P
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp A         &kp S         &kp D         &kp F         &kp G             &kp H         &kp J         &kp K         &kp L         &kp SEMI
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp Z         &kp X         &kp C         &kp V         &kp B             &kp N         &kp M       &kp COMMA      &kp DOT       &kp MINUS
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                 &lt WM LGUI   &lt FN LALT   &smart_shft        &kp SPACE      &mo CFG      &kp BSPC
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // FN-Tasten links | Zahlenblock rechts
        // Daumen: Tab / [gehalten] / Esc  |  KP_0 / [gehalten] / Enter
        fn_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp KP_STAR    &kp KP_N7     &kp KP_N8     &kp KP_N9   &kp KP_SLASH
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10         &kp KP_PLUS    &kp KP_N4     &kp KP_N5     &kp KP_N6   &kp KP_MINUS
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp F11       &kp F12       ______        ______        ______          &kp KP_EQUAL   &kp KP_N1     &kp KP_N2     &kp KP_N3    &kp KP_DOT
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    &kp TAB       ______        &kp ESC          &kp KP_N0      ______        &kp RET
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // Links: Fensterverwaltung (Raycast Standard-Shortcuts)
        //   Reihe 1: Mission Control | App-Exposé
        //   Reihe 2: Oben-Links-Viertel | Links-Hälfte | Maximieren | Rechts-Hälfte | Oben-Rechts-Viertel
        //   Reihe 3: Sticky-Modifier (Cmd / Alt / Ctrl / Shift) für Combos mit Mausklicks
        // Rechts: Maussteuerung
        //   Reihe 1: Scrollen hoch          Reihe 2: Mausbewegung + Scrollen runter
        //   Daumen: Linksklick / Rechtsklick / Mittelklick
        wm_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp LC(UP)  &kp LC(DOWN)    ______        ______        ______            ______        ______     &mmv MOVE_UP    ______      &msc SCRL_UP
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
   &kp LC(LA(U)) &kp LC(LA(LEFT)) &kp LC(LA(RET)) &kp LC(LA(RIGHT)) &kp LC(LA(I))  ______  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &sk LGUI      &sk LALT      &sk LCTRL     &sk LSHFT      ______            ______        ______        ______        ______        ______
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    ______        ______        ______            &mkp MB1      &mkp MB2      &mkp MB3
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // Konfiguration: Bluetooth | Audio | Ausgabe
        cfg_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      ______        ______        ______      &out OUT_USB  &out OUT_BLE
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &bt BT_CLR    ______        ______        ______        ______            ______       &kp C_VOL_DN  &kp C_VOL_UP  &kp K_MUTE    ______
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        ______        ______        ______        ______        ______            ______       &kp C_PREV    &kp C_PP     &kp C_NEXT    ______
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    ______        ______        ______            ______        ______        ______
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };
    };
};
