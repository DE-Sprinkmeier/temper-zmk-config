 *
 * Setzt deutsches QWERTZ-Layout im Betriebssystem voraus.
 * Fenster-Shortcuts: Raycast Window Management (Standardbelegung).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define QWTZ 0
#define FN   1
#define WM   2
#define CFG  3

#define ______ &trans

/ {
    behaviors {
        smart_shft: smart_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };
        // Deutsches QWERTZ: Shift+, → ; und Shift+. → :
        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(COMMA)>;
            mods = <(MOD_LSFT)>;
        };
        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp LS(DOT)>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // QWERTZ – Setzt deutsches QWERTZ im OS voraus.
        // kp Y → HID Y-Code → deutsches OS → 'z'
        // kp Z → HID Z-Code → deutsches OS → 'y'
        // kp SEMI → HID Semikolon → deutsches OS → 'ö'
        qwertz_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp Q         &kp W         &kp E         &kp R         &kp T             &kp Y         &kp U         &kp I         &kp O         &kp P
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp A         &kp S         &kp D         &kp F         &kp G             &kp H         &kp J         &kp K         &kp L         &kp SEMI
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp Z         &kp X         &kp C         &kp V         &kp B             &kp N         &kp M       &comma_semi    &dot_colon     &kp MINUS
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                 &lt WM LGUI   &lt FN LALT   &smart_shft        &kp SPACE      &mo CFG      &kp BSPC
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // FN-Tasten links | Zahlenblock rechts
        // Daumen: Tab · Option · Esc  |  KP_0 · RCtrl · Enter
        // Reihe 3 links: F11 · F12 · Druck · Pos1 · Ende
        fn_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp KP_STAR    &kp KP_N7     &kp KP_N8     &kp KP_N9   &kp KP_SLASH
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10         &kp KP_PLUS    &kp KP_N4     &kp KP_N5     &kp KP_N6   &kp KP_MINUS
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp F11       &kp F12       &kp PSCRN     &kp HOME      &kp END         &kp KP_EQUAL   &kp KP_N1     &kp KP_N2     &kp KP_N3    &kp KP_DOT
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    &kp TAB       &kp LALT      &kp ESC          &kp KP_N0     &kp RCTRL      &kp RET
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // Links: Fensterverwaltung (Raycast Standard-Shortcuts)
        //   R1: MissionCtrl · AppExposé · ⌘Leertaste(Raycast) · ⌘Tab(Switcher) · ⌃⌥↓(Unten-Halb)
        //   R2: ObenLinks · LinksHälfte · Maximieren · RechtsHälfte · ObenRechts
        //   R3: sk⌘ · sk⌥ · sk⌃ · sk⇧ · ⌃⌥C(Zentrieren)
        // Rechts: Maus
        //   R1: MB4(Zurück) · MB5(Vor) · Hoch · ⌃⌥⌫(Wiederherstellen) · ScrUp
        //   R2: · Links · Runter · Rechts · ScrDn
        //   R3: Scr← · ESC · RET · DEL · Scr→
        //   Daumen: [Layer] · Option · Shift  |  MB1 · MB2 · MB3
        wm_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp LC(UP)  &kp LC(DOWN)  &kp LG(SPACE)  &kp LG(TAB)  &kp LC(LA(DOWN))  &mkp MB4      &mkp MB5   &mmv MOVE_UP  &kp LC(LA(BSPC)) &msc SCRL_UP
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
   &kp LC(LA(U)) &kp LC(LA(LEFT)) &kp LC(LA(RET)) &kp LC(LA(RIGHT)) &kp LC(LA(I))  ______  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &sk LGUI      &sk LALT      &sk LCTRL     &sk LSHFT   &kp LC(LA(C))     &msc SCRL_LEFT  &kp ESC      &kp RET       &kp DEL     &msc SCRL_RIGHT
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                    ______        &kp LALT     &kp LSHFT         &mkp MB1      &mkp MB2      &mkp MB3
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // Konfiguration: Bluetooth | Audio | Ausgabe | System
        //   R1 links: BT 0-4  |  R1 rechts: Druck · Heller− · Heller+ · USB · BLE
        //   R2 links: BT_CLR · OutToggle · ⌃⌘Q(Sperre) · Schlaf · CapsLock
        //   R2 rechts: Schlaf · Vol− · Vol+ · Mute · App-Menü
        //   R3 links: Reset · Bootl. · ⌘⇧3 · ⌘⇧4 · ⌘⇧5
        //   R3 rechts: Stop · Zurück · Play/Pause · Weiter · Auswerfen
        //   Daumen: Cmd · Option · Shift  |  Space · [Layer] · Backspace
        cfg_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp PSCRN    &kp C_BRI_DN  &kp C_BRI_UP  &out OUT_USB  &out OUT_BLE
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &bt BT_CLR   &out OUT_TOG  &kp LC(LG(Q))  &kp C_SLEEP   &kp CAPS        &kp C_SLEEP  &kp C_VOL_DN  &kp C_VOL_UP  &kp K_MUTE    &kp K_APP
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &sys_reset    &bootloader  &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5))  &kp C_STOP   &kp C_PREV    &kp C_PP     &kp C_NEXT    &kp C_EJECT
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &kp LGUI      &kp LALT     &kp LSHFT         &kp SPACE      ______       &kp BSPC
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
            >;
        };
    };
};
